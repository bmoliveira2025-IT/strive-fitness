  {
    "id": "111",
    "name": "Chest Dip",
    "url": "https://www.lyfta.app/exercise/chest-dip-88",
    "video_url": "https://apilyfta.com/static/GymvisualMP4/02511201-Chest-Dip_Chest.mp4",
