{
  "expo": {
    "name": "Strive Fitness",
    "slug": "strive-app",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "strive-fitness-br",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.bmoliveira.strive",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/adaptive-icon.png",
      "name": "Strive Workout",
      "shortName": "Strive",
      "display": "standalone",
      "themeColor": "#121619",
      "backgroundColor": "#121619",
      "description": "Seu companheiro inteligente de treinos"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProperties": [
              {
                "key": "org.gradle.jvmargs",
                "value": "-Xmx4096m -XX:MaxMetaspaceSize=512m"
              }
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo_transparent.png",
          "color": "#8B5CF6"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fbee111-b6ba-4a55-b601-d7c19a2618d0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fbee111-b6ba-4a55-b601-d7c19a2618d0"
    }
  }
}
