{
  "version": 2,
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/strive.apk",
      "destination": "https://github.com/bmoliveira2025-IT/strive-fitness/releases/download/v1.0.19/strive1.0.19.apk",
      "permanent": false
    },
    {
      "source": "/strive1.0.19.apk",
      "destination": "https://github.com/bmoliveira2025-IT/strive-fitness/releases/download/v1.0.19/strive1.0.19.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
